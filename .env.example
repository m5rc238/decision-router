# Decision Router — local demo configuration.
# .env.local is gitignored (via *.local). The dev middleware reads these in
# addition to the process environment. Restart `npm run dev` after edits.

# --- Big Pickle (LLM stages) ---
# Runs on the local OpenCode desktop server. These vars are usually inherited
# from the OpenCode desktop environment; OPENCODE_SERVER_PASSWORD is a
# per-launch secret that the desktop app injects into sessions it spawns.
OPENCODE_SERVER_URL=http://localhost:63445
OPENCODE_SERVER_USERNAME=opencode
OPENCODE_SERVER_PASSWORD=
OPENCODE_MODEL_ID=big-pickle
OPENCODE_PROVIDER_ID=opencode

# --- Jev judgment (real, API-only decision model) ---
# Required for the Jev stage. The demo never fakes the judge — without a key
# the Jev stage fails visibly with a precise reason.
# Two supported providers (same { model, state, questions } body and response):
#   - Official TypeSafe "System One":  https://api.typesafe.ai/v1/systemone  (apikey_... key)
#   - Hosted Jev proxy:                 https://jevtypesafeai.com/api/v1/decide (jv_live_... key)
JEV_API_URL=https://api.typesafe.ai/v1/systemone
JEV_API_KEY=
# Copy this file to .env.local and fill in your key.
